{
  "name": "amir-lajevardi-portfolio",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build:portfolio": "vite build --config config/interactive.vite.ts",
    "predev": "npm run build:portfolio",
    "prebuild": "npm run build:portfolio",
    "dev:portfolio": "vite build --config config/interactive.vite.ts --watch",
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vite",
    "build": "vinext build",
    "deploy": "wrangler deploy --config dist/server/wrangler.json",
    "deploy:check": "wrangler deploy --config dist/server/wrangler.json --dry-run",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "npm run build && node --test tests/*.test.mjs",
    "typecheck": "tsc --noEmit --incremental false",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern .wrangler --ignore-pattern .sites-runtime"
  },
  "dependencies": {
    "d3": "^7.8.5",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@types/d3": "^7.4.3",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
